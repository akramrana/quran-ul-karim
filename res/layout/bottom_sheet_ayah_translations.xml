<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="20dp">

    <!-- Title and close button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/translationTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ayah Translations"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/translationClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="22sp"
            android:textColor="@color/text_primary"
            android:contentDescription="Close translations"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Language selection -->
    <Spinner
        android:id="@+id/languageSpinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp" />

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/translationProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="16dp"
        android:visibility="gone" />

    <!-- Scrollable translation -->
    <ScrollView
        android:id="@+id/translationScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fillViewport="false"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/translationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:lineSpacingExtra="5dp"
            android:textIsSelectable="true" />

    </ScrollView>

    <!-- Translator -->
    <TextView
        android:id="@+id/translatorName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

    <!-- Source attribution -->
    <TextView
        android:id="@+id/translationSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:gravity="center"
        android:text="Source: fawazahmed0-quran-api-v1"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>