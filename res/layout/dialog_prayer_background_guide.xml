<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:background="@color/colorAboutBg"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:id="@+id/imgGuide"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:scaleType="fitCenter" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="🕌 Improve Prayer Notification Reliability"
        android:textColor="@color/colorWhite"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="To help ensure prayer reminders are delivered exactly on time, some phones require an additional background setting."
        android:textColor="@color/colorWhite"
        android:textSize="15sp" />

    <!-- Navigation Card -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_info_box"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open"
            android:textStyle="bold"
            android:textColor="@color/colorWhite"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="App Info → Power usage details → Launch settings"
            android:textColor="@color/colorWhite"
            android:textStyle="bold"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Turn 'Manage automatically' OFF, then enable:"
        android:textColor="@color/colorWhite"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="6dp"
        android:text="✓ Auto-launch&#10;✓ Secondary launch&#10;✓ Run in background"
        android:textColor="@color/colorWhite"
        android:textSize="15sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="This only needs to be done once.\n\nIf these options are not available on your phone, you can safely ignore this message."
        android:textColor="@color/colorWhite"
        android:textSize="13sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end">

        <Button
            android:id="@+id/btnGotIt"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/orange_border"
            android:paddingHorizontal="22dp"
            android:text="Got it"
            android:textAllCaps="false"
            android:textColor="@android:color/white"/>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/contrast_green_border"
            android:paddingHorizontal="22dp"
            android:text="Open App Info"
            android:textAllCaps="false"
            android:textColor="@android:color/white"/>

    </LinearLayout>

</LinearLayout>